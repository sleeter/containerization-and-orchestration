{
 "uid": "shop-continuity",
 "title": "shop: непрерывность при хаосе подов",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Запросы клиента в секунду по результату",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(loadgen_requests_total[30s]))",
     "legendFormat": "{{result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Провалившиеся запросы клиента (за период)",
   "type": "stat",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(loadgen_requests_total{result!=\"ok\"}[$__range])) or vector(0)",
     "legendFormat": "упало"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Успешных запросов (за период)",
   "type": "stat",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(loadgen_requests_total{result=\"ok\"}[$__range]))",
     "legendFormat": "успешно"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "title": "Пересозданные поды api/worker за последнюю минуту",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(time() - kube_pod_start_time{namespace=\"shop\",pod=~\"api-.*|worker-.*\"} < 60) or vector(0)",
     "legendFormat": "новых подов"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Готовые поды в Endpoints сервиса api",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_pod_status_ready{namespace=\"shop\",condition=\"true\",pod=~\"api-.*\"} == 1)",
     "legendFormat": "готовых api"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "p95 задержки на стороне клиента",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(loadgen_request_duration_seconds_bucket[1m])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  }
 ]
}